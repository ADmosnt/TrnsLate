# TrnsLate Configuration
# Copy this file to .env and adjust values as needed

# Enable GPU acceleration for OCR (requires CUDA-compatible torch)
GPU=true

# Source language to detect
SOURCE=en

# Target language for translation
TARGET=es

# Overlay opacity (0.0 = fully transparent, 1.0 = fully opaque)
OPACITY=0.25

# Initial overlay window size
WIDTH=500
HEIGHT=350

# Translation refresh interval in milliseconds
INTERVAL=3000
